# Application
APP_NAME=景区导览AI数字人
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1

# Security / Admin
SECRET_KEY=change-me-to-a-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_API_TOKEN=scenic-admin-token-2026

# Knowledge Base Upload
KB_UPLOAD_DIR=./data/uploads

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=scenic_user
POSTGRES_PASSWORD=scenic_pass
POSTGRES_DB=scenic_guide
# Database（默认 SQLite，零配置可用）
DATABASE_URL=sqlite+aiosqlite:///./data/scenic_guide.db
# PostgreSQL 可选：
# DATABASE_URL=postgresql+asyncpg://scenic_user:scenic_pass@localhost:5432/scenic_guide

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# LLM (多模态大模型)
# LLM_PROVIDER: mock（本地模拟）| openai（OpenAI 兼容，含 DeepSeek / 通义 / 智谱等）
LLM_PROVIDER=mock
LLM_API_KEY=your-llm-api-key
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o
# DeepSeek 示例（将 LLM_PROVIDER 改为 openai）：
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-你的deepseek密钥
# LLM_API_BASE=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
LLM_TIMEOUT=30

# ASR (语音识别)
ASR_PROVIDER=faster-whisper
ASR_API_KEY=your-asr-api-key
ASR_API_BASE=
ASR_MODEL=small
# ASR_MODEL_PATH=./data/models/faster-whisper-small
ASR_HF_ENDPOINT=https://hf-mirror.com
ASR_OPENAI_MODEL=whisper-1
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
ASR_TIMEOUT=60
ASR_MIN_DURATION_MS=500

# TTS (语音合成 - Edge-TTS)
TTS_VOICE=zh-CN-XiaoxiaoNeural
TTS_RATE=+0%
TTS_VOLUME=+0%
TTS_OUTPUT_DIR=./data/tts_cache
TTS_PUBLIC_BASE_URL=http://localhost:8000

# RAG / Embedding / Chroma
EMBEDDING_MODEL=BAAI/bge-m3
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=scenic_docs
SCENIC_DOCS_DIR=./data/scenic_docs
SCENIC_POIS_FILE=./data/scenic_pois.json
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=3

# Session Memory
SESSION_MEMORY_MAX_TURNS=3
SESSION_MEMORY_TTL=3600
USE_REDIS_SESSION=true

# Object Storage (音频/文件)
OSS_ENDPOINT=
OSS_ACCESS_KEY=
OSS_SECRET_KEY=
OSS_BUCKET=scenic-guide

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# ---------------------------------------------------------------------------
# Docker 部署说明（docker-compose.yml 会自动覆盖部分变量）
# ---------------------------------------------------------------------------
# REDIS_HOST=redis
# REDIS_URL=redis://redis:6379/0
# DATABASE_URL=sqlite+aiosqlite:///./data/scenic_guide.db
# TTS_PUBLIC_BASE_URL=http://localhost
# CORS_ORIGINS=http://localhost
# FORCE_REINDEX=false    # 设为 true 强制重建向量库
# RESET_INDEX=false      # 设为 true 清空后重建
